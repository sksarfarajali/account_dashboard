# Copy the keys below into your Streamlit Community Cloud app's
# Settings -> Secrets box (TOML format). Do not commit an actual
# secrets.toml — it's git-ignored.

# Cloud Postgres connection string (e.g. from Neon or Supabase).
DATABASE_URL = "postgresql+psycopg2://user:password@host:5432/dbname?sslmode=require"

# From a "Web application" OAuth client in Google Cloud Console
# (APIs & Services -> Credentials). See README's cloud-deployment section.
GMAIL_CLIENT_ID = "xxxxxxxx.apps.googleusercontent.com"
GMAIL_CLIENT_SECRET = "xxxxxxxx"

# Your deployed app's own URL — must exactly match an "Authorized redirect
# URI" on that same OAuth client.
REDIRECT_URI = "https://your-app-name.streamlit.app"

GMAIL_SCOPES = "https://www.googleapis.com/auth/gmail.readonly"
