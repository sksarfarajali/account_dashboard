# Copy this file to .env and fill in real values. Never commit .env.

# --- PostgreSQL ---
POSTGRES_USER=finance_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=finance_dashboard
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://finance_user:change_me@localhost:5432/finance_dashboard

# --- Gmail OAuth ---
# Path to the OAuth client file you download from Google Cloud Console
# (see README for exact setup steps). Do not commit this file.
GMAIL_CREDENTIALS_PATH=./credentials.json
# Where the generated refresh/access token will be cached after first login.
GMAIL_TOKEN_PATH=./token.json
# Read-only scope only — do not widen this.
GMAIL_SCOPES=https://www.googleapis.com/auth/gmail.readonly
